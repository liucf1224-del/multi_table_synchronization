# 复制成 .env 后按环境填写:  cp .env.example .env && chmod 600 .env
# 注意: .env 已被 .gitignore 排除, 不要提交(里面有数据库密码)

# ============ 要同步的表清单(核心配置) ============
# 逗号或换行分隔, 三种写法:
#   tbl               源/目标同名, 各自用下面配置的默认库
#   A=B               目标表改名
#   db.tbl=db2.tbl2   指定库(跨库/跨实例时用)
# 新增一张表: 加到这里 -> 重启容器 -> 新表自动全量回填+对账, 其它表不受影响
#   (回填期间源库的变更会从断点位点重放补齐, 幂等, 不会漏)
# 建议一次只加一张表, 回填耗时 = 单表回填耗时; 全部重灌只在 --resync / 断点失效自愈时发生。
SYNC_TABLES=value_added_advert_orders

# 兼容旧写法: 不配 SYNC_TABLES 时, 回退到下面两行(单表模式)
# SRC_TABLE=value_added_advert_orders
# DST_TABLE=value_added_advert_orders

# ============ 源库(数据源 / FastAdmin) ============
# 生产若换成其它服务器/账号，直接改这一组即可
DB_HOST_FASTADMIN=
DB_PORT_FASTADMIN=3306
DB_DATABASE_FASTADMIN=
DB_USERNAME_FASTADMIN=
DB_PASSWORD_FASTADMIN=

# ============ 目标库(同步到) ============
# 生产若换成其它服务器/账号，直接改这一组即可
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ============ 连接字符集(一般不用改, 老库才需要) ============
# 默认 utf8mb4。若某一侧是 MySQL 5.5.3 以下(不认 utf8mb4), 把它改成 utf8, 否则直接连不上。
# SRC_CHARSET=utf8mb4
# DST_CHARSET=utf8mb4

# ============ 会话时区(一般不用改, 留空即 +00:00) ============
# 脚本已默认把 读/写 连接统一强制为 UTC(+00:00), 保证 TIMESTAMP 字段往返不偏移。
# 只有你非常确定需要其它基准时才改这里, 例如: TIME_ZONE=+08:00
# TIME_ZONE=+00:00

# ============ 位点失效自愈(默认开, 一般不用改) ============
# 源库(尤其 RDS)按时间清理 binlog 导致断点失效时, 自动「全量重灌 + 对账 + 位点重新对齐」。
# 源表极大、不希望自动重灌时设为 0(改为只报错重试, 需人工处理)。
# AUTO_RESYNC=1

# ============ 调优(一般不用改) ============
# 回填每批行数上限; 实际还会按目标库 max_allowed_packet 自动收敛, 遇到"包过大"会二分重试。
# 目标库是 MySQL 5.x(默认 max_allowed_packet=1MB)时不要设太大。
# BACKFILL_BATCH=500
# 复制流的 server_id: 多容器部署时每个容器必须不同(默认随机)
# SERVER_ID=123456
